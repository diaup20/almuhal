rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read/write for Almahl Transport data (site settings, services, contact requests)
    match /site_settings/{document=**} {
      allow read, write: if true;
    }
    match /contact_requests/{document=**} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
